---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/legacy/LegacyBaseLayout.astro";
import LegacyPostList from "../../components/legacy/LegacyPostList.astro";
import { getPosts } from "../../lib/get-posts";
import { buildTagIndex } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const index = buildTagIndex(await getPosts());
  return index.map(({ tag, posts }) => ({ params: { tag }, props: { posts } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={tag}>
  <p>Posts tagged with {tag}</p>
  <LegacyPostList posts={posts} />
</BaseLayout>
