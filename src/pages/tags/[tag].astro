---
// Tag page (HP theme), spec 5.11 and Q4: the Life listing's band and rows,
// with each row's section chip, since a tag crosses sections.
import type { GetStaticPaths } from "astro";
import ListingBand from "../../components/hp/ListingBand.astro";
import PostList from "../../components/hp/PostList.astro";
import PostRow from "../../components/hp/PostRow.astro";
import { SECTIONS } from "../../data/sections";
import HpLayout from "../../layouts/HpLayout.astro";
import { formatList, plural } from "../../lib/format";
import { getPosts } from "../../lib/get-posts";
import { buildTagIndex, sectionsOf } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const index = buildTagIndex(await getPosts());
  return index.map(({ tag, count, posts }) => ({ params: { tag }, props: { count, posts } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { count, posts } = Astro.props;
const sections = formatList(sectionsOf(posts).map((section) => SECTIONS[section].label));
---

<HpLayout title={`#${tag} — sasky.nz`} description={`Every post tagged ${tag} on sasky.nz, from ${sections}.`}>
  <ListingBand headingId="tag-h" label={plural(count, "post")} title={`#${tag}`}>
    <Fragment slot="lede">
      Posts from {sections}. Pick another tag on the <a href="/#tags">home page</a>.
    </Fragment>
  </ListingBand>
  <PostList heading={`Every post tagged ${tag}, newest first`}>
    {posts.map((post) => <PostRow post={post} chip currentTag={tag} />)}
  </PostList>
</HpLayout>
