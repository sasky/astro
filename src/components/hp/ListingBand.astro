---
// The HP listing header band: plus marks, blue wash, a count Dymo, the
// heading, a lede and an optional intro. Values: Site-Life-List.dc.html.
// The 404 uses it with no wash and the "message" heading.
import Dymo from "../site/Dymo.astro";

interface Props {
  headingId: string;
  label: string;
  title: string;
  lede?: string;
  intro?: string;
  /** The blue wash on the right; on by default. */
  wash?: boolean;
  /** "section" is the one-word listing heading; "message" a short sentence. */
  variant?: "section" | "message";
}

const { headingId, label, title, lede, intro, wash = true, variant = "section" } = Astro.props;
const plusId = `${headingId}-plus`;
const hasLede = lede || Astro.slots.has("lede");
---

<section class:list={["band", `band-${variant}`]} aria-labelledby={headingId}>
  <div class="band-deco" aria-hidden="true">
    <svg class="plus">
      <defs>
        <pattern id={plusId} width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M20 13v14M13 20h14" stroke="#ff6a1f" stroke-opacity="0.6" stroke-width="2"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#${plusId})`}></rect>
    </svg>
    {
      wash && (
        <div class="wash">
          <div class="wash-grain" />
        </div>
      )
    }
  </div>
  <div class="band-in">
    <Dymo tone="navy" as="p">{label}</Dymo>
    <h1 id={headingId}>{title}</h1>
    {
      hasLede && (
        <p class="lede">
          <slot name="lede">{lede}</slot>
        </p>
      )
    }
    {intro && <p class="intro">{intro}</p>}
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
  }

  .band-section {
    border-bottom: 2px solid var(--navy);
  }

  .band-deco {
    position: absolute;
    inset: 0;
  }

  .plus {
    position: absolute;
    top: 0;
    left: 0;
    width: 54%;
    height: 100%;
    opacity: 0.55;
  }

  .wash {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 58%;
    background-color: var(--blue);
    opacity: 0.85;
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.12) 26%, rgba(0, 0, 0, 0.55) 58%, #000 100%);
  }

  .wash-grain {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.07) 0px, rgba(255, 255, 255, 0.07) 1px, transparent 1px, transparent 28px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.07) 0px, rgba(255, 255, 255, 0.07) 1px, transparent 1px, transparent 28px);
  }

  .band-in {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 88px var(--gutter) 72px;
  }

  h1 {
    margin: 0;
    color: var(--navy);
    font-family: var(--display-font);
    font-weight: 800;
  }

  .band-section h1 {
    font-size: 120px;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .band-message h1 {
    max-width: 12ch;
    font-size: clamp(48px, 9vw, 96px);
    /* Looser than the one-word section heading, so the words stay apart. */
    letter-spacing: -0.03em;
    word-spacing: 0.06em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .lede {
    max-width: 560px;
    margin: 0;
    color: var(--lede);
    font-family: var(--display-font);
    font-size: 28px;
    font-style: italic;
    line-height: 1.3;
  }

  .intro {
    max-width: 52ch;
    margin: 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .band-in {
      padding: 52px 20px 44px;
    }

    .band-section h1 {
      font-size: 72px;
    }

    .lede {
      font-size: 22px;
    }

    .wash {
      width: 100%;
    }
  }
</style>
