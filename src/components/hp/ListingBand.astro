---
// The HP listing header band: plus marks across its width, a count Dymo, the
// heading, a lede and an optional intro. Values: Site-Life-List.dc.html, less
// the board's blue wash, which made the intro hard to read on phones.
// The 404 uses it with the "message" heading.
import Dymo from "../site/Dymo.astro";
import { headingFit } from "../../lib/fit";

interface Props {
  headingId: string;
  label: string;
  title: string;
  lede?: string;
  intro?: string;
  /** "section" is the one-word listing heading; "message" a short sentence. */
  variant?: "section" | "message";
}

const { headingId, label, title, lede, intro, variant = "section" } = Astro.props;
const plusId = `${headingId}-plus`;
const hasLede = lede || Astro.slots.has("lede");
---

<section class:list={["band", `band-${variant}`]} aria-labelledby={headingId}>
  <div class="band-deco" aria-hidden="true">
    <svg class="plus">
      <defs>
        <pattern id={plusId} width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M20 13v14M13 20h14" stroke="#ff6a1f" stroke-opacity="0.6" stroke-width="2"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#${plusId})`}></rect>
    </svg>
  </div>
  <div class="band-in">
    <Dymo tone="navy" as="p">{label}</Dymo>
    <h1 id={headingId} style={variant === "section" ? headingFit(title) : undefined}>{title}</h1>
    {
      hasLede && (
        <p class="lede">
          <slot name="lede">{lede}</slot>
        </p>
      )
    }
    {intro && <p class="intro">{intro}</p>}
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
  }

  .band-section {
    border-bottom: 2px solid var(--navy);
  }

  .band-deco {
    position: absolute;
    inset: 0;
  }

  .plus {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.55;
  }

  .band-in {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    container-type: inline-size;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 88px var(--gutter) 72px;
  }

  h1 {
    margin: 0;
    color: var(--navy);
    font-family: var(--display-font);
    font-weight: 800;
  }

  /* One word, sized to fit its measured width (--em, from headingFit): "Life" stays 120px, "#silverstripe" shrinks. */
  .band-section h1 {
    /* Fixed first, for browsers without container units. */
    font-size: 120px;
    font-size: min(120px, calc(100cqi / var(--em)));
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .band-message h1 {
    max-width: 12ch;
    font-size: clamp(48px, 9vw, 96px);
    /* Looser than the one-word section heading, so the words stay apart. */
    letter-spacing: -0.03em;
    word-spacing: 0.06em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .lede {
    max-width: 560px;
    margin: 0;
    color: var(--lede);
    font-family: var(--display-font);
    font-size: 28px;
    font-style: italic;
    line-height: 1.3;
  }

  .intro {
    max-width: 52ch;
    margin: 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .band-in {
      padding: 52px 20px 44px;
    }

    .band-section h1 {
      font-size: 72px;
      font-size: min(72px, calc(100cqi / var(--em)));
    }

    .lede {
      font-size: 22px;
    }
  }
</style>
