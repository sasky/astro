---
// Home "Browse by tag" (spec 5.11). Every tag's list is in the HTML; only the
// first (most-used) tag's list shows. Without JS the chips link to the tag
// pages; src/scripts/tag-selector.ts turns them into toggle buttons.
// Values: TagSelector.dc.html.
import SectionChip from "../site/SectionChip.astro";
import { formatDateISO, formatDateLong, plural } from "../../lib/format";
import type { PostEntry } from "../../lib/get-posts";
import { postUrl } from "../../lib/posts";

interface Props {
  index: { tag: string; count: number; posts: PostEntry[] }[];
}

const { index } = Astro.props;
const summary = (tag: string, count: number) => `${plural(count, "post")} tagged ${tag}`;
const first = index[0];
---

{
  first && (
    <section id="tags" class="tg-card" aria-labelledby="tags-h" data-tag-selector>
      <div class="tg-head">
        <h2 id="tags-h">Browse by tag</h2>
        <p class="tg-intro">Tags run across Code, Life and On. Pick one to see every post with it.</p>
      </div>
      <div class="tg-chips" role="group" aria-label="Tags">
        {index.map(({ tag, count }, i) => (
          <a
            class="tg-chip"
            href={`/tags/${tag}`}
            data-tag={tag}
            data-selected={i === 0 ? "" : undefined}
            aria-label={`${tag}, ${plural(count, "post")}`}
          >
            <span>{tag}</span>
            <span class="tg-count" aria-hidden="true">
              {count}
            </span>
          </a>
        ))}
      </div>
      <div class="tg-results">
        <p class="tg-summary" aria-live="polite">
          {summary(first.tag, first.count)}
        </p>
        {index.map(({ tag, count, posts }, i) => (
          <ul class="tg-list" role="list" data-tag-list={tag} data-summary={summary(tag, count)} hidden={i !== 0}>
            {posts.map((post) => (
              <li>
                <a class="tg-row" href={postUrl(post)}>
                  <SectionChip section={post.data.section} />
                  <span class="tg-title">{post.data.title}</span>
                  <time class="tg-date" datetime={formatDateISO(post.data.pubDate)}>
                    {formatDateLong(post.data.pubDate)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  )
}

<script>
  import "../../scripts/tag-selector";
</script>

<style>
  .tg-card {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 36px 40px 30px;
    border: 2px solid var(--navy);
    background-color: var(--card);
    box-shadow: 8px 8px 0 var(--blue);
  }

  .tg-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h2 {
    margin: 0;
    color: var(--navy);
    font-family: var(--display-font);
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .tg-intro {
    margin: 0;
    color: var(--lede);
    font-family: var(--display-font);
    font-size: 20px;
    font-style: italic;
    line-height: 1.4;
  }

  .tg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tg-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin: 0;
    padding: 0 10px 0 16px;
    border: 2px solid var(--navy);
    border-radius: 3px;
    background-color: transparent;
    color: var(--navy);
    cursor: pointer;
    font-family: var(--mono-font);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.12s ease;
  }

  .tg-chip:hover {
    background-color: rgba(36, 82, 255, 0.12);
    color: var(--navy);
  }

  .tg-chip:active {
    translate: 0 1px;
  }

  .tg-count {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 6px;
    border-radius: 2px;
    background-color: rgba(18, 22, 61, 0.1);
    color: var(--navy);
    font-size: 13px;
  }

  /* The selected chip: a pressed button, or the default tag's link without JS. */
  .tg-chip[aria-pressed="true"],
  a.tg-chip[data-selected] {
    background-color: var(--navy);
    box-shadow: 0 3px 0 rgba(18, 22, 61, 0.3);
    color: #ffffff;
    transform: rotate(-1.5deg);
  }

  .tg-chip[aria-pressed="true"] .tg-count,
  a.tg-chip[data-selected] .tg-count {
    background-color: var(--orange);
    color: var(--navy);
  }

  .tg-results {
    display: flex;
    flex-direction: column;
  }

  .tg-summary {
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--navy);
    color: var(--muted);
    font-family: var(--mono-font);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tg-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tg-list[hidden] {
    display: none;
  }

  .tg-list li {
    border-bottom: 2px dashed rgba(18, 22, 61, 0.2);
  }

  .tg-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    min-height: 44px;
    padding: 14px 8px;
    color: var(--navy);
    text-decoration: none;
    transition: background-color 0.12s ease;
  }

  .tg-row:hover {
    background-color: rgba(36, 82, 255, 0.06);
    color: var(--navy);
  }

  .tg-title {
    flex: 1 1 280px;
    min-width: 0;
    font-family: var(--display-font);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .tg-row:hover .tg-title {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .tg-date {
    flex-shrink: 0;
    color: var(--muted);
    font-family: var(--mono-font);
    font-size: 13px;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .tg-card {
      gap: 22px;
      padding: 26px 18px 20px;
    }

    h2 {
      font-size: 38px;
    }

    .tg-row {
      padding: 12px 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tg-chip,
    .tg-row {
      transition: none;
    }

    .tg-chip:active {
      translate: none;
    }
  }
</style>
