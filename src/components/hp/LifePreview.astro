---
// The Life door's preview: graph paper, a blue wash and the italic "Life".
// Decorative; Door marks it aria-hidden. Values: .gl-life in Site-Home.dc.html.
---

<span class="preview-life">
  <span class="wash"></span>
  <span class="title"><span class="mark"></span>Life</span>
</span>

<style>
  .preview-life {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 24px;
    overflow: hidden;
    background-color: var(--page-bg);
    background-image:
      repeating-linear-gradient(0deg, rgba(36, 82, 255, 0.13) 0px, rgba(36, 82, 255, 0.13) 1px, transparent 1px, transparent 28px),
      repeating-linear-gradient(90deg, rgba(36, 82, 255, 0.13) 0px, rgba(36, 82, 255, 0.13) 1px, transparent 1px, transparent 28px);
  }

  .wash {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 62%;
    background-color: var(--blue);
    opacity: 0.85;
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.4) 45%, #000 100%);
  }

  .title {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--navy);
    font-family: var(--display-font);
    font-size: 54px;
    font-style: italic;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .mark {
    display: block;
    width: 16px;
    height: 16px;
    background-color: var(--orange);
    box-shadow: 5px 5px 0 var(--blue);
    transform: rotate(-8deg);
  }
</style>
