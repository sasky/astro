---
// The Code door's preview: a terminal prompt with a blinking cursor.
// Decorative; Door marks it aria-hidden. Values: .gl-code in Site-Home.dc.html.
---

<span class="preview-code">
  <span class="prompt">
    <span class="user">cam@sasky</span><span class="punct">:</span><span class="dir">~</span><span class="punct">{"$ "}</span><span class="cmd">cd code</span>
  </span>
  <span class="title"><span class="hash">#</span>Code<span class="cursor"></span></span>
</span>

<style>
  .preview-code {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    height: 100%;
    padding: 0 24px;
    background-color: #0b0f0d;
    background-image:
      repeating-linear-gradient(to bottom, rgba(190, 255, 215, 0.05) 0px, rgba(190, 255, 215, 0.05) 1px, transparent 1px, transparent 3px),
      radial-gradient(ellipse 80% 70% at 50% 0%, rgba(110, 231, 160, 0.16), transparent 70%);
    color: #c8d6cb;
    font-family: var(--font-jetbrains);
  }

  .prompt {
    font-size: 13px;
  }

  .user {
    color: #6ee7a0;
    font-weight: 700;
  }

  .punct {
    color: #7d8f82;
  }

  .dir {
    color: #8cc8ff;
  }

  .cmd {
    color: #eef5f0;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #eef5f0;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.1;
    text-shadow: 0 0 20px rgba(110, 231, 160, 0.35);
  }

  .hash {
    color: #6ee7a0;
  }

  .cursor {
    display: block;
    width: 14px;
    height: 32px;
    background-color: #6ee7a0;
    animation: door-cursor-blink 1.1s steps(1) infinite;
  }

  @keyframes door-cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
