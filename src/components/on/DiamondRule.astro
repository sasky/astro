---
// A 3px rule broken by three diamonds. Values: Site-On-*.dc.html.
---

<div class="diamond-rule" aria-hidden="true">
  <span class="line"></span>
  <span class="diamond"></span>
  <span class="diamond diamond-open"></span>
  <span class="diamond"></span>
  <span class="line"></span>
</div>

<style>
  .diamond-rule {
    display: flex;
    align-items: center;
    gap: 10px;
    align-self: stretch;
  }

  .line {
    flex-grow: 1;
    height: 3px;
    background-color: var(--ink-on);
  }

  .diamond {
    width: 12px;
    height: 12px;
    background-color: var(--ink-on);
    transform: rotate(45deg);
  }

  .diamond-open {
    width: 18px;
    height: 18px;
    box-sizing: border-box;
    border: 3px solid var(--ink-on);
    background-color: transparent;
  }
</style>
