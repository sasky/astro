---
// The all-seeing eye with its sunburst, from the On listing's bill.
// Values: Site-On-List.dc.html.
---

<div class="eye" aria-hidden="true">
  <div class="rays"></div>
  <svg class="eye-svg" viewBox="0 0 300 150" focusable="false">
    <path class="lid" d="M10 75 C 70 8, 230 8, 290 75 C 230 142, 70 142, 10 75 Z" stroke-width="5"></path>
    <path class="crease" d="M26 66 C 84 18, 216 18, 274 66" stroke-width="2"></path>
    <g class="lashes" stroke-width="2.2" stroke-linecap="round">
      <path d="M60 40 L52 28"></path>
      <path d="M90 26 L86 13"></path>
      <path d="M122 19 L120 6"></path>
      <path d="M150 17 L150 4"></path>
      <path d="M178 19 L180 6"></path>
      <path d="M210 26 L214 13"></path>
      <path d="M240 40 L248 28"></path>
    </g>
    <circle class="iris" cx="150" cy="78" r="47"></circle>
    <circle class="ring" cx="150" cy="78" r="40" stroke-width="1.3" stroke-dasharray="2 3"></circle>
    <circle class="ring" cx="150" cy="78" r="32" stroke-width="1" stroke-dasharray="1.5 3.2"></circle>
    <circle class="pupil" cx="150" cy="78" r="19"></circle>
    <circle class="glint" cx="167" cy="62" r="7.5"></circle>
  </svg>
</div>

<style>
  .eye {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 640px;
    max-width: 100%;
    height: 300px;
  }

  .rays {
    position: absolute;
    inset: 0;
    background-image: repeating-conic-gradient(from 0deg, rgba(35, 23, 14, 0.85) 0deg 0.7deg, transparent 0.7deg 3.6deg);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, transparent 32%, #000 36%, #000 66%, transparent 76%);
  }

  .eye-svg {
    position: relative;
    width: 300px;
    height: 150px;
  }

  .lid {
    fill: var(--kraft);
    stroke: var(--ink-on);
  }

  .crease,
  .ring {
    fill: none;
  }

  .crease,
  .lashes {
    stroke: var(--ink-on);
  }

  .iris {
    fill: var(--ink-on);
  }

  .ring {
    stroke: var(--kraft);
  }

  .pupil {
    fill: #0f0a06;
  }

  .glint {
    fill: var(--light);
  }

  @media (max-width: 760px) {
    .eye {
      width: 100%;
      height: 190px;
    }

    .eye-svg {
      width: 200px;
      height: 100px;
    }
  }
</style>
