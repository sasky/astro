---
// A grid of images inside a post's column: two across, each in a dashed
// frame that hugs its image. The images come from the MDX as <Picture>s;
// give them `widths` and the `sizes` below the grid's cells so they stay sharp.
---

<div class="image-collection">
  <slot />
</div>

<style>
  .image-collection {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Each frame keeps its own height, so the dashes sit 6px from every edge. */
    align-items: start;
    gap: 16px;
  }

  .image-collection > :global(picture) {
    display: block;
    padding: 6px;
    border: 1px dashed var(--rule-dashed);
  }

  .image-collection :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
