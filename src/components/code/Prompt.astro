---
// A shell prompt line: cam@sasky:{path}$ {cmd}. Values: Site-Code-List.dc.html
// and Site-Code-Post.dc.html. `link` makes the leading ~ a link home;
// `crumbs` turns every path segment into a breadcrumb link.
interface Props {
  path?: string;
  cmd?: string;
  /** Link the leading ~ to Home. */
  link?: boolean;
  /** Render the path as a breadcrumb: ~ → /, ~/code → /code. */
  crumbs?: boolean;
  /** End with a blinking block cursor. */
  cursor?: boolean;
}

const { path = "~", cmd, link = false, crumbs = false, cursor = false } = Astro.props;
const segments = path.replace(/^~\/?/, "").split("/").filter(Boolean);
const startsHome = path.startsWith("~");
---

<div class="prompt">
  <span class="prompt-user">cam@sasky</span><span class="prompt-punct">:</span>{
    crumbs && startsHome ? (
      <nav class="prompt-crumbs" aria-label="Breadcrumb">
        <a class="lnk" href="/">~</a>
        {segments.map((segment, i) => (
          <>
            <span class="prompt-path">/</span>
            <a class="lnk" href={`/${segments.slice(0, i + 1).join("/")}`}>{segment}</a>
          </>
        ))}
      </nav>
    ) : link && startsHome ? (
      <>
        <a class="lnk" href="/">~</a>
        {segments.length > 0 && <span class="prompt-path">/{segments.join("/")}</span>}
      </>
    ) : (
      <span class="prompt-path">{path}</span>
    )
  }<span class="prompt-punct">$&nbsp;</span>{cmd && <span class="prompt-cmd">{cmd}</span>}
  {cursor && <span class="prompt-cursor" aria-hidden="true" />}
</div>

<style>
  .prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .prompt-user {
    color: var(--accent);
    font-weight: 700;
  }

  .prompt-punct {
    color: var(--muted);
  }

  .prompt-path {
    color: var(--path-blue);
  }

  .prompt-cmd {
    color: var(--bright);
  }

  /* 44px tap targets around single characters like "~", without
     changing the line's height. */
  .prompt .lnk {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: -10px -8px;
    padding: 0 8px;
  }

  .prompt-crumbs {
    display: inline-flex;
  }

  /* In a breadcrumb the links are only a "/" apart, so each one grows its
     target outward instead: "~" to the left (over the plain "cam@sasky:"),
     later segments to the right. Keeps neighbours from overlapping (WCAG 2.5.8). */
  .prompt-crumbs .lnk {
    margin: -10px -8px -10px 0;
    padding: 0 8px 0 0;
  }

  .prompt-crumbs .lnk:first-child {
    margin: -10px 0 -10px -16px;
    padding: 0 0 0 16px;
  }

  .prompt-cursor {
    display: inline-block;
    width: 9px;
    height: 18px;
    background-color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .prompt-cursor {
      animation: prompt-cursor-blink 1.1s steps(1) infinite;
    }
  }

  @keyframes prompt-cursor-blink {
    50% {
      opacity: 0;
    }
  }
</style>
