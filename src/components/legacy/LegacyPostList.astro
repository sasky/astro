---
// Temporary: the old Home post list, used by Home, the section listings and
// the tag pages until the themed listings replace it.
import { toAnchor } from "../../scripts/utils";
import { postUrl } from "../../lib/posts";
import type { PostEntry } from "../../lib/get-posts";

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<nav id="menu" class="home-nav">
  <ul>
    {
      posts.map((post) => (
        <li>
          <a id={toAnchor(postUrl(post))} href={postUrl(post)} data-astro-reload={!!post.data.pico8}>
            {post.data.title}
          </a>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</nav>
