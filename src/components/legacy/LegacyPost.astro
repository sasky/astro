---
// Temporary: the old MarkdownPostLayout, adapted to render a collection
// entry. Replaced by the theme post templates in Phases 4–6.
import { render } from "astro:content";
import BaseLayout from "../../layouts/legacy/LegacyBaseLayout.astro";
import Pico8 from "../Pico8.astro";
import type { PostEntry } from "../../lib/get-posts";
import { formatDateISO } from "../../lib/format";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateYMD = formatDateISO(post.data.pubDate);
const dateDDMMYYYY = post.data.pubDate.toLocaleDateString("en-GB", { timeZone: "UTC" });
---

<style>
  .tags {
    display: inline-block;
    margin: 0 0 var(--size-6) 0;
    background-image: var(--gradient-21);
    border-radius: 5px;
  }

  .tags a {
    display: inline-block;
    padding: var(--size-4) var(--size-5);
    color: var(--stone-2);
  }
  .tags a:hover {
    color: var(--red-7);
    background-image: var(--gradient-5);
  }
  em {
    margin: 0 0 var(--size-5) 0;
  }
</style>

<BaseLayout pageTitle={post.data.title} metaDescription={post.data.metaDescription ?? post.data.description}>
  <time datetime={dateYMD}>{dateDDMMYYYY}</time>
  <nav class="tags">
    {post.data.tags.map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}
  </nav>
  <p><em>{post.data.description}</em></p>
  {post.data.pico8 && <Pico8 pico8src={post.data.pico8} />}
  <Content />
</BaseLayout>
