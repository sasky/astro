---
// Decorative background layers: the theme's pattern plus a tiled grain.
// They cover the whole page behind the content and can't be clicked.
interface Props {
  /** Texture strength (0–1). Defaults to the theme's --texture-opacity. */
  opacity?: number;
}

const { opacity } = Astro.props;
---

<div class="texture" aria-hidden="true" style={opacity === undefined ? undefined : `--t: ${opacity}`}>
  <div class="texture-pattern"></div>
  <div class="texture-grain"></div>
</div>

<style>
  .texture {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }

  .texture-pattern,
  .texture-grain {
    position: absolute;
    inset: 0;
  }

  .texture-pattern {
    background-image: var(--texture-pattern);
    opacity: var(--t, var(--texture-opacity));
  }

  .texture-grain {
    background-image: var(--texture-grain);
    background-size: 240px 240px;
    mix-blend-mode: var(--grain-blend);
    opacity: calc(var(--t, var(--texture-opacity)) * var(--grain-factor));
  }
</style>
