---
// The document shell for redesigned pages. Theme layouts (HpLayout,
// CodeLayout, OnLayout) wrap it and add their CSS, fonts and chrome.
import "../styles/base.css";
import { pagePath } from "../lib/paths";

interface Props {
  theme: "hp" | "code" | "on";
  title: string;
  description: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const { theme, title, description, ogType = "website", noindex = false } = Astro.props;
// The canonical URL: Home is https://sasky.nz/, everything else has no slash or .html.
const url = new URL(pagePath(Astro.url), Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en-NZ" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={url} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="sasky.nz" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="sasky.nz" href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
